{
  "manifest_version": 2,
  "name": "Defeating Manipulation — Selected Text Analyser",
  "version": "0.2.0",
  "description": "Locally compares short passages with the Defeating Manipulation technique library.",
  "permissions": ["activeTab", "tabs", "storage", "https://huggingface.co/*", "https://cdn-lfs.huggingface.co/*", "https://*.xethub.hf.co/*"],
  "browser_action": {
    "default_title": "Analyse selected text for manipulation patterns",
    "default_icon": {"16":"icons/green-flag.svg","32":"icons/green-flag.svg","48":"icons/green-flag.svg"}
  },
  "background": {"page":"background.html"},
  "web_accessible_resources": ["techniques.json"],
  "applications": {"gecko":{"id":"pattern-highlighter@defeating-manipulation.org","strict_min_version":"115.0"}},
  "icons":{"48":"icons/green-flag.svg"}
}
